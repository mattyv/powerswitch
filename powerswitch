#!/usr/bin/env python3
"""Auto-switch power profiles on AC/battery.

No args  -> settings window.
--daemon -> watch UPower, apply the configured profile.
"""
import json
import pathlib
import subprocess
import sys

import gi

from gi.repository import Gio, GLib  # noqa: E402

# Gtk is pinned inside daemon()/gui(): the tray needs Gtk3 (AppIndicator),
# the settings window needs Gtk4. They cannot share a process.
SELF = pathlib.Path(__file__).resolve()

PROFILES = ["performance", "balanced", "power-saver"]
BOOST, BASE = "performance", "balanced"  # the two the tray icon flips between
DEFAULTS = {"ac": "balanced", "battery": "power-saver"}
CONFIG = pathlib.Path(GLib.get_user_config_dir()) / "powerswitch.json"
SERVICE = "powerswitch.service"

UPOWER = ("org.freedesktop.UPower", "/org/freedesktop/UPower", "org.freedesktop.UPower")
PPD = ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles", "net.hadess.PowerProfiles")
WATCHER = ("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
           "org.kde.StatusNotifierWatcher")

APP_ID = "powerswitch"
SNI_IFACE = "org.kde.StatusNotifierItem"
SNI_PATH = "/StatusNotifierItem"
# where libayatana-appindicator exports the menu once set_menu() is called
MENU_PATH = f"/org/ayatana/NotificationItem/{APP_ID}/Menu"
# the watcher holds this call open until gnome-shell has finished starting, which at
# login is well past the 25s D-Bus default
REGISTER_TIMEOUT_MS = 5 * 60 * 1000
# Our own tray item. libayatana's has no Activate method, so GNOME's appindicator
# extension sets supportsActivation = false and its double-click path never runs
# (indicatorStatusIcon.js: _maybeHandleDoubleClick). Declaring Activate is the whole
# reason this exists — everything else here is the minimum the shell reads.
SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <method name="Activate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
    <method name="SecondaryActivate"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
    <method name="ContextMenu"><arg type="i" direction="in"/><arg type="i" direction="in"/></method>
    <method name="Scroll"><arg type="i" direction="in"/><arg type="s" direction="in"/></method>
    <signal name="NewIcon"/>
  </interface>
</node>
"""


def load():
    try:
        cfg = {**DEFAULTS, **json.loads(CONFIG.read_text())}
    except (OSError, ValueError, TypeError):  # missing, corrupt, or not a JSON object
        return dict(DEFAULTS)
    # config is hand-editable, so don't trust it into a D-Bus call
    return {k: v if v in PROFILES else DEFAULTS[k] for k, v in cfg.items() if k in DEFAULTS}


def save(cfg):
    # two writers now (settings window and tray toggle), so never leave a half file
    tmp = CONFIG.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2))
    tmp.replace(CONFIG)


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


# --- daemon ---------------------------------------------------------------

def proxy(triple):
    name, path, iface = triple
    return Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None, name, path, iface, None
    )


def flip(profile):
    """The other of BOOST/BASE; anything else boosts."""
    return BASE if profile == BOOST else BOOST


def indicator(toggle):
    """Top bar icon, or None if AppIndicator isn't available (headless, no extension)."""
    try:
        gi.require_version("Gtk", "3.0")
        gi.require_version("AyatanaAppIndicator3", "0.1")
        from gi.repository import AyatanaAppIndicator3 as AppIndicator
        from gi.repository import Gtk
    except (ImportError, ValueError):
        return None

    menu = Gtk.Menu()
    state = Gtk.MenuItem(label="…")
    state.set_sensitive(False)
    settings = Gtk.MenuItem(label="Settings…")
    # systemd-run, not Popen: a plain child shares this service's cgroup, so the
    # settings window would kill itself the moment it restarted or disabled us.
    settings.connect("activate", lambda _: subprocess.Popen(
        ["systemd-run", "--user", "--quiet", "--collect", str(SELF)]
    ))
    boost = Gtk.MenuItem(label=f"Toggle {BOOST}/{BASE}")
    boost.connect("activate", lambda _: toggle())
    # ponytail: no Quit item — the service owns the lifetime, use the settings toggle
    for item in (state, Gtk.SeparatorMenuItem(), boost, settings):
        menu.append(item)
    menu.show_all()

    # Left PASSIVE on purpose: the shell hides it, but set_menu() still exports the
    # menu over D-Bus, which our own item below points at. Nothing else here can
    # build a dbusmenu without pulling in a new package.
    ind = AppIndicator.Indicator.new(
        APP_ID, "power-profile-balanced-symbolic", AppIndicator.IndicatorCategory.HARDWARE,
    )
    ind.set_menu(menu)

    icon = "power-profile-balanced-symbolic"

    def on_call(_conn, _sender, _path, _iface, method, _args, invocation):
        # double-click and middle-click both land here; right-click gets the menu
        try:
            if method in ("Activate", "SecondaryActivate"):
                toggle()
        finally:
            # always answer: the shell awaits this call, and a skipped reply hangs
            # the click for the full D-Bus timeout
            invocation.return_value(None)

    def on_get(_conn, _sender, _path, _iface, prop):
        if prop == "Menu":
            return GLib.Variant("o", MENU_PATH)
        if prop == "ItemIsMenu":
            return GLib.Variant("b", False)  # false = we handle clicks, menu is secondary
        value = {"Category": "Hardware", "Id": APP_ID, "Title": "Power Switch",
                 "Status": "Active", "IconName": icon}.get(prop)
        return GLib.Variant("s", value) if value else None

    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        node = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
        bus.register_object(SNI_PATH, node.interfaces[0], on_call, on_get, None)
    except GLib.Error as e:  # no session bus, or the path is taken
        print(f"tray unavailable: {e}", flush=True)
        return None

    def registered(_bus, result, _data):
        try:
            bus.call_finish(result)
        except GLib.Error as e:
            print(f"tray registration failed: {e}", flush=True)

    def register(*_):
        """Also runs when gnome-shell restarts and a new watcher appears."""
        # async: at login the watcher sits on this call until the shell has finished
        # starting, and a blocking wait there would stall plug events too
        bus.call(*WATCHER, "RegisterStatusNotifierItem", GLib.Variant("(s)", (SNI_PATH,)),
                 None, Gio.DBusCallFlags.NONE, REGISTER_TIMEOUT_MS, None, registered, None)

    Gio.bus_watch_name_on_connection(
        bus, WATCHER[0], Gio.BusNameWatcherFlags.NONE, register, None)

    # ind and menu are otherwise unreferenced once we return, and GC takes the menu
    # off the bus with them
    def update(on_battery, profile, _keepalive=(ind, menu)):
        nonlocal icon
        icon = f"power-profile-{profile}-symbolic"
        state.set_label(f"{'On battery' if on_battery else 'Plugged in'} — {profile}")
        bus.emit_signal(None, SNI_PATH, SNI_IFACE, "NewIcon", None)

    return update


def daemon():
    upower, ppd = proxy(UPOWER), proxy(PPD)
    update = None

    def apply(*_):
        on_battery = upower.get_cached_property("OnBattery").get_boolean()
        want = load()["battery" if on_battery else "ac"]
        active = ppd.get_cached_property("ActiveProfile").get_string()
        # Someone else (GNOME's low-battery saver, a game) is holding a profile —
        # writing ActiveProfile would release their hold, so leave it alone.
        # ponytail: we only watch UPower, so after a hold releases the profile stays
        # as they left it until the next plug event. Watch PPD too if that grates —
        # but then we'd also stomp profiles you picked by hand in Quick Settings.
        held = bool(ppd.get_cached_property("ActiveProfileHolds").unpack())
        if active != want and not held:
            ppd.get_connection().call_sync(
                PPD[0], PPD[1], "org.freedesktop.DBus.Properties", "Set",
                GLib.Variant("(ssv)", (PPD[2], "ActiveProfile", GLib.Variant("s", want))),
                None, Gio.DBusCallFlags.NONE, -1, None,
            )
            print(f"on_battery={on_battery} -> {want}", flush=True)
            subprocess.Popen([
                "notify-send", "-a", "Power Switch", "-i", f"power-profile-{want}-symbolic",
                "On battery" if on_battery else "Plugged in", f"Power mode: {want}",
            ])
            active = want
        if update:
            update(on_battery, active)

    def toggle():
        """Flip the profile for whichever source is live, and make it stick."""
        key = "battery" if upower.get_cached_property("OnBattery").get_boolean() else "ac"
        cfg = load()
        # flip what is actually in force, not what is configured — otherwise the first
        # click after a manual change in Quick Settings looks like it did nothing
        cfg[key] = flip(ppd.get_cached_property("ActiveProfile").get_string())
        save(cfg)
        apply()

    update = indicator(toggle)
    upower.connect("g-properties-changed", apply)
    try:
        apply()  # startup is the one path where an exception would kill the service
    except Exception as e:
        print(f"initial apply failed: {e}", flush=True)
    GLib.MainLoop().run()


# --- gui ------------------------------------------------------------------

def gui():
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gtk

    class Window(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Power Switch", default_width=460)
            cfg = load()

            group = Adw.PreferencesGroup(title="Profile to use")
            for key, label in (("ac", "Plugged in"), ("battery", "On battery")):
                row = Adw.ComboRow(title=label, model=Gtk.StringList.new(PROFILES))
                row.set_selected(PROFILES.index(cfg[key]))
                row.connect("notify::selected", self.on_profile, key)
                group.add(row)

            self.switch = Adw.SwitchRow(
                title="Switch automatically", subtitle="Runs in the background at login"
            )
            self.switch.set_active(systemctl("is-active", "--quiet", SERVICE).returncode == 0)
            self.switch.connect("notify::active", self.on_toggle)
            group.add(self.switch)

            page = Adw.PreferencesPage()
            page.add(group)
            view = Adw.ToolbarView(content=page)
            view.add_top_bar(Adw.HeaderBar())
            self.set_content(view)

        def on_profile(self, row, _param, key):
            # re-read: the tray toggle may have written the other key since we opened
            cfg = load()
            cfg[key] = PROFILES[row.get_selected()]
            save(cfg)
            systemctl("try-restart", SERVICE)

        def on_toggle(self, switch, _param):
            verb = "enable" if switch.get_active() else "disable"
            systemctl(verb, "--now", SERVICE)

    app = Adw.Application(application_id="dev.local.PowerSwitch")
    app.connect("activate", lambda a: Window(a).present())
    app.run([])


if __name__ == "__main__":
    daemon() if "--daemon" in sys.argv else gui()
