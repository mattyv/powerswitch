        "comments": {
          "__diagram__": [
            {
              "id": "d1",
              "text": "UPower source changes drive the plug and unplug arrows (powerswitch:290-301). The tray drives the flip arrows and disables AC auto mode before saving (powerswitch:337-349). When opted in, aggregate CPU samples drive the two AC auto arrows through AutoPerformancePolicy (powerswitch:127-161, 351-378).",
              "ts": 1786953600000
            }
          ],
          "balanced": [
            {
              "id": "b1",
              "text": "Default for AC (powerswitch:23-25) and the base state for load-based mode. Balanced already boosts short work; auto mode waits for five consecutive samples at or above 80% before requesting performance.",
              "ts": 1786953600000
            }
          ],
          "powersaver": [
            {
              "id": "p1",
              "text": "Default for battery. Also the profile GNOME's Automatic Power Saver takes a hold on when the battery gets low \u2014 see the self-loop.",
              "ts": 1786953600000
            }
          ],
          "performance": [
            {
              "id": "f1",
              "text": "Reached by configuration, the tray flip, or opted-in AC load mode after 10 seconds at or above 80% aggregate CPU use. Auto mode returns to balanced after 60 seconds at or below 35%, subject to a 60-second minimum dwell (powerswitch:127-161). Firmware may still degrade performance on battery.",
              "ts": 1786953600000
            }
          ]
        }
      }
