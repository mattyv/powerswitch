        "comments": {
          "__diagram__": [
            {
              "id": "a1",
              "text": "apply() runs on UPower changes, startup, tray toggles, and relevant PPD changes. The two-second load timer calls it only when hysteresis changes the desired profile. The hold and already-correct guards still make the common path write nothing.",
              "ts": 1786953600000
            }
          ],
          "event": [
            {
              "id": "e1",
              "text": "Lid open/close also lands here because LidIsClosed shares the UPower interface. apply() distinguishes a real AC/battery transition before clearing a manual pause or resetting the policy (powerswitch:290-301).",
              "ts": 1786953600000
            }
          ],
          "held": [
            {
              "id": "h1",
              "text": "Reads ActiveProfileHolds before every write (powerswitch:312-324). A held profile is never overwritten. The PPD watcher records the hold and resumes the current automatic decision only after it clears (powerswitch:380-408).",
              "ts": 1786953600000
            }
          ],
          "toggle": [
            {
              "id": "g1",
              "text": "GNOME's appindicator extension only runs its double-click path when the tray item exports Activate. Power Switch publishes that method on its own StatusNotifierItem; Activate and SecondaryActivate both call toggle() (powerswitch:189-277).",
              "ts": 1786996800000
            }
          ],
          "flipcfg": [
            {
              "id": "g2",
              "text": "toggle() flips the profile actually in force for the live power source, saves it, then calls apply() (powerswitch:337-349). On AC it also disables load-based mode, making the explicit tray choice persistent.",
              "ts": 1786996800000
            }
          ],
          "readcfg": [
            {
              "id": "c1",
              "text": "load() parses the two profile values and the backward-compatible auto_performance_ac boolean (powerswitch:78-92). The settings window restarts the user service after a change; runtime events also re-read the file.",
              "ts": 1786953600000
            }
          ],
          "sample": [
            {
              "id": "s1",
              "text": "Reads aggregate ticks from /proc/stat every two seconds. Delta busy time yields CPU capacity use normalized across all cores; iowait counts as idle (powerswitch:106-124, 351-378).",
              "ts": 1786936380000
            }
          ],
          "loadpolicy": [
            {
              "id": "l1",
              "text": "AutoPerformancePolicy is a pure state machine. Five consecutive samples at or above 80% enter performance; thirty at or below 35% return to balanced; every switch starts a 60-second dwell (powerswitch:127-161).",
              "ts": 1786936380000
            }
          ],
          "ppdevent": [
            {
              "id": "p2",
              "text": "The daemon watches ActiveProfile and ActiveProfileHolds. This closes the old hold-release gap without treating Power Switch's own writes as manual changes (powerswitch:380-408).",
              "ts": 1786936380000
            }
          ],
          "override": [
            {
              "id": "o1",
              "text": "An unheld external ActiveProfile change pauses AC auto mode until the next real power-source transition. A held change freezes writes and resumes after release (powerswitch:164-172, 380-408).",
              "ts": 1786936380000
            }
          ],
          "sleep": [
            {
              "id": "s2",
              "text": "login1 PrepareForSleep clears the previous CPU snapshot and partial streaks before sleep and reapplies the current decision after resume (powerswitch:410-426).",
              "ts": 1786936380000
            }
          ],
          "tray": [
            {
              "id": "t1",
              "text": "Always reached from apply(). The icon shows the profile actually in force; its menu text also says when AC automation is active or paused (powerswitch:270-275, 331-335).",
              "ts": 1786953600000
            }
          ]
        }
      }
