        "comments": {
          "__diagram__": [
            {
              "id": "d1",
              "text": "Two triggers move between these states. UPower's OnBattery property changing (subscribed in powerswitch:212) drives the plug and unplug arrows; only two of those are live on the shipped defaults (ac = balanced, battery = power-saver). Double-clicking the tray icon drives the flip arrows, which rewrite the stored profile for whichever state is live and re-run apply().",
              "ts": 1786953600000
            }
          ],
          "balanced": [
            {
              "id": "b1",
              "text": "Default for AC (DEFAULTS in powerswitch:21). Full boost under load, but the platform profile stays quiet and cool.",
              "ts": 1786953600000
            }
          ],
          "powersaver": [
            {
              "id": "p1",
              "text": "Default for battery. Also the profile GNOME's Automatic Power Saver takes a hold on when the battery gets low \u2014 see the self-loop.",
              "ts": 1786953600000
            }
          ],
          "performance": [
            {
              "id": "f1",
              "text": "Never entered on the defaults. Reached either by choosing it in the settings window or by double-clicking the tray icon, which flips the live state's stored profile to performance (flip() in powerswitch:89 sends anything that is not performance here). Firmware may silently degrade it on battery (PPD reports lap-detected or high-operating-temperature), so the state is set but not necessarily delivered.",
              "ts": 1786953600000
            }
          ]
        }
      }
    },
